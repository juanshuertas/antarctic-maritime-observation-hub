{
  "name": "@amoh/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "pnpm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "assets:public": "node scripts/import-pages-assets.mjs",
    "build:pages": "vite build --config vite.pages.config.ts",
    "build:pb124": "vite build --config vite.pb124.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@amoh/contracts": "workspace:*",
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@mapbox/vector-tile": "3.0.0",
    "@turf/turf": "^7.4.0",
    "canvas-confetti": "^1.9.4",
    "cesium": "1.146.0",
    "framer-motion": "^13.4.0",
    "h3-js": "^4.5.0",
    "lerc": "^2.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.10.0",
    "pbf": "5.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "satellite.js": "6.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
